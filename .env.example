# SMTP — any standard provider (your domain mailbox, a Gmail App Password, Resend, etc.).
# Put the REAL values in your host's environment variables (e.g. Netlify), not here —
# this committed example must contain placeholders only. SMTP_PASS = mailbox/app password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-mailbox-password
SMTP_TO=you@example.com
SMTP_FROM=Your Site <you@example.com>

# Umami analytics (optional). Leave blank to disable — the site works without it,
# and form-submission events log to the console in dev instead.
# Get these from your Umami dashboard: Settings > Websites > (your site).
NUXT_PUBLIC_ANALYTICS_UMAMI_SRC=https://your-umami-instance/script.js
NUXT_PUBLIC_ANALYTICS_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
