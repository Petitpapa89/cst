# SMTP — Porkbun email hosting for the chienneesoccertraining.com domain mailbox.
# SMTP_PASS is the mailbox password set in the Porkbun Email panel (not the
# Porkbun account password). Confirm host/port in that panel if needed.
# Any standard SMTP provider works here (Gmail App Password, Resend, etc.).
SMTP_HOST=smtp.porkbun.com
SMTP_PORT=587
SMTP_USER=support@chienneesoccertraining.com
SMTP_PASS=your-mailbox-password
SMTP_TO=support@chienneesoccertraining.com
SMTP_FROM=CST Website <support@chienneesoccertraining.com>

# Umami analytics (optional). Leave blank to disable — the site works without it,
# and form-submission events log to the console in dev instead.
# Get these from your Umami dashboard: Settings > Websites > (your site).
NUXT_PUBLIC_ANALYTICS_UMAMI_SRC=https://your-umami-instance/script.js
NUXT_PUBLIC_ANALYTICS_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
